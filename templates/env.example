# Секреты mcp-semantic-search-zvec-go. Не коммитить.
# Создаётся при install как .mcp-semantic-search-zvec-go/.env
#
# Ниже — примеры для профилей из config.yaml. Можно добавлять свои KEY=VALUE:
# в config.yaml укажите api_key_env: MY_CUSTOM_KEY, здесь — MY_CUSTOM_KEY=значение.
#
# routerai_bge_m3, routerai_openai_small:
ROUTERAI_API_KEY=
#
# dashscope_beijing, dashscope_intl:
DASHSCOPE_API_KEY=
#
# HTTP API при запуске с --http (Bearer auth):
API_TOKEN=
#
# LM Studio с включённой авторизацией (профиль lmstudio_*):
# LM_STUDIO_API_KEY=lm-studio
#
# Свой провайдер:
# MY_CUSTOM_KEY=
