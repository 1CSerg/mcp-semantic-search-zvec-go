<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema>
  <name>ОтчётПоОстаткам</name>
  <query>ВЫБРАТЬ
    Номенклатура.Наименование,
    СУММА(Остатки.Количество) КАК Остаток
  ИЗ
    РегистрНакопления.ОстаткиНаСкладах КАК Остатки
    ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
        ПО Остатки.Номенклатура = Номенклатура.Ссылка
  СГРУППИРОВАТЬ ПО
    Номенклатура.Наименование</query>
  <query>ВЫБРАТЬ
    Склад.Наименование,
    СУММА(Остатки.Количество) КАК ОстатокПоСкладу
  ИЗ
    РегистрНакопления.ОстаткиНаСкладах КАК Остатки
    ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склад
        ПО Остатки.Склад = Склад.Ссылка
  СГРУППИРОВАТЬ ПО
    Склад.Наименование</query>
  <field name="Ref"/>
</DataCompositionSchema>
