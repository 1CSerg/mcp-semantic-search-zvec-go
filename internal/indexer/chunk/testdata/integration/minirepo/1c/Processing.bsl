// Процедура Привет — точка входа обработки.
Процедура Привет() Экспорт
    Сообщить("Привет");
КонецПроцедуры

// Встроенный запрос остатки на складах.
Процедура ПолучитьОстатки() Экспорт
    Запрос = Новый Запрос(
        "ВЫБРАТЬ
        |   Номенклатура.Ссылка,
        |   СУММА(Остатки.Количество) КАК Остаток
        |ИЗ
        |   РегистрНакопления.ОстаткиНаСкладах КАК Остатки
        |   ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
        |       ПО Остатки.Номенклатура = Номенклатура.Ссылка
        |СГРУППИРОВАТЬ ПО
        |   Номенклатура.Ссылка");
    Результат = Запрос.Выполнить();
КонецПроцедуры

#КонецОбласти
